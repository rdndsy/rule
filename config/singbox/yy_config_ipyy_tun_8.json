{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  },
  "dns": {
    "servers": [
      {
        "tag": "proxyDns",
        "type": "https",
        "server": "dns.google",
        "path": "/dns-query",
        "domain_resolver": "defaultDns",
        "domain_strategy": "ipv4_only",
        "detour": "🚀 节点选择"
      },
      {
        "tag": "localDns",
        "type": "h3",
        "server": "dns.alidns.com",
        "path": "/dns-query",
        "domain_resolver": "defaultDns",
        "domain_strategy": "ipv4_only"
      },
      {
        "tag": "defaultDns",
        "type": "udp",
        "server": "119.29.29.29",
        "server_port": 53
      }
    ],
    "rules": [
      {
        "rule_set": [
          "geosite-ads",
          "geosite-ads2"
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "server": "localDns"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "server": "localDns"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "server": "proxyDns"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "geosite-geolocation-!cn",
            "invert": true
          },
          {
            "rule_set": "geoip-cn"
          }
        ],
        "action": "route",
        "server": "proxyDns",
        "client_subnet": "114.114.114.114/24"
      }
    ],
    "final": "proxyDns",
    "strategy": "ipv4_only"
  },
  "http_clients": [
    {
      "tag": "direct-http",
      "domain_resolver": "defaultDns"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "address": "172.19.0.1/30",
      "mtu": 9000,
      "auto_route": true,
      "stack": "system",
      "strict_route": true,
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 2080
        }
      }
    },
    {
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 2080,
      "users": []
    }
